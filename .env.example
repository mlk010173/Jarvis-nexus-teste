# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WAKE_TOKEN: guarda opcional do endpoint /api/wake.
# Se definido, automações externas (n8n/cron/webhooks) devem enviar o header
# x-wake-token com o mesmo valor. Sem ele, o wake fica aberto (modo dev).
WAKE_TOKEN=""

# ===== Canal WhatsApp =====
# Cloud API oficial da Meta (free tier): https://developers.facebook.com
# OU bridge local sem Meta: bridges/whatsapp-web (QR no seu celular)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
META_VERIFY_TOKEN="jarvis-nexus"
WHATSAPP_ALLOWED_FROM="5527998518705"

# Número E.164 sem + do DONO (destino padrão de notificações)
OWNER_WHATSAPP="5527998518705"

# ===== Gmail (e-mails do agente) =====
# ATENÇÃO: Google exige "senha de app" (conta > Segurança > Verificação em 2 etapas > Senhas de app)
GMAIL_USER=""
GMAIL_PASS=""

# ===== Navegador ao vivo self-hosted =====
# Rode uma vez no servidor: npx playwright install chromium
LIVE_BROWSER_ALLOW_LOCAL=""
