# Workflow de exemplo: "Código GitHub no Gmail -> WhatsApp"
# Equivalente open-source do workflow Base44 "Código GitHub no Gmail".
#
# No n8n (self-host, free):
#   Gmail Trigger (on message received, filtro: from:noreply@github.com)
#     -> HTTP Request  POST http://agent-api:8000/wake
#        body: {
#          "message": "Chegou e-mail do GitHub. Extraia o código de verificação
#                      e envie ao dono no WhatsApp com remetente e assunto.",
#          "source": "gmail-github-watch"
#        }
#
# O agent-api recebe, o runtime lê o contexto, extrai o código do corpo
# (a tool search_web/imap fica no sandbox) e chama tools.send_whatsapp.
# Allowlist de destinatários é obrigatória (tools._send_whatsapp + ALLOWED_SENDERS).

{
  "name": "github-code-from-gmail",
  "trigger": {
    "config": { "trigger_type": "connector", "integration_type": "gmail",
                "events": ["mailbox"],
                "condition": "${ .trigger.data.has_new_non_draft_messages == true }" },
    "note": "No clone: n8n Gmail Trigger com o mesmo filtro semântico"
  },
  "definition": {
    "document": { "dsl": "1.0.0", "name": "github_code_from_gmail", "version": "1.0", "namespace": "base44" },
    "do": [
      { "checar_email": {
          "call": "invoke_superagent_step",
          "with": { "message": "Leia os e-mails novos (IDs: ${ .trigger.data.new_message_ids }). Se for do GitHub com código de verificação, envie o código ao dono via WhatsApp. Se não for, ignore. Nunca poste códigos em público." },
          "then": "end" } }
    ]
  }
}
